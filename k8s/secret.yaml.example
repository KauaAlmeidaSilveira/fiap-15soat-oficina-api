# Template de referência — NÃO contém segredos reais.
# Copie para secret.yaml (gitignorado) e preencha com valores reais, ou gere via
# `kubectl create secret` conforme documentado em k8s/README.md.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-api-secrets
  namespace: oficina
type: Opaque
stringData:
  DB_PASSWORD: "<SENHA_DO_BANCO_RDS>"
  GMAIL_SMTP_USERNAME: "<ENDERECO_GMAIL_REMETENTE>"
  GMAIL_SMTP_PASSWORD: "<APP_PASSWORD_DO_GMAIL>"
  NEW_RELIC_LICENSE_KEY: "<LICENSE_KEY_DO_NEW_RELIC>"
  jwt.private.key: |
    -----BEGIN PRIVATE KEY-----
    <CONTEUDO_DA_CHAVE_PRIVADA_RSA>
    -----END PRIVATE KEY-----
  jwt.public.key: |
    -----BEGIN PUBLIC KEY-----
    <CONTEUDO_DA_CHAVE_PUBLICA_RSA>
    -----END PUBLIC KEY-----
