# Copie para .env (gitignorado) e preencha com valores reais.
# O docker-compose carrega esse arquivo automaticamente.
# Usado apenas pelo profile "default" (NotificacaoAprovacaoSmtpService) para enviar
# o e-mail real de aprovação de orçamento via SMTP do Gmail.

GMAIL_SMTP_USERNAME=<endereco-gmail-remetente>
GMAIL_SMTP_PASSWORD=<app-password-do-gmail>
