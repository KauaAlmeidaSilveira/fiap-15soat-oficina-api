# Copie para terraform.tfvars (gitignorado) e preencha os valores reais.
# Nunca commitar terraform.tfvars — contém a senha do banco.

aws_region   = "us-east-1"
project_name = "oficina"

db_password = "<senha-forte-do-rds>"

# --- New Relic ---
# account_id: visivel na URL quando logado. Nao e segredo.
# api_key: New Relic > Administration > API keys > Create a key > Key type = USER.
#          Comeca com NRAK-. NAO confundir com a license key (termina em NRAL).
newrelic_account_id = 7428180
newrelic_api_key    = "NRAK-<sua-user-api-key>"
newrelic_region     = "US"
alertas_email       = "<email-que-recebe-os-alertas>"
