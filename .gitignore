# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# Vscode
.vscode/

# Maven
target/

# JWT Keys - nunca versionar chaves RSA no repositorio
# Gere localmente com os comandos no README.
# Sem barra no inicio, o padrao casa em QUALQUER diretorio - inclusive na raiz,
# onde as chaves acabam sendo geradas por engano e escapavam da regra antiga,
# que so cobria src/main/resources/.
jwt.private.key
jwt.public.key

# Kubernetes Secret real - nunca versionar (contem senha de DB e chaves JWT)
# Use k8s/secret.yaml.example como template e gere o real conforme k8s/README.md
k8s/secret.yaml

# Terraform - estado local, cache de providers e variaveis com segredos
# Sem barra no inicio, os padroes casam em qualquer diretorio (hoje observability/,
# e nao quebram se surgir outra pasta com Terraform).
# (.terraform.lock.hcl NAO entra aqui - deve ser commitado para builds reprodutiveis)
.terraform/
terraform.tfvars
terraform.tfstate*
crash.log

# Credenciais SMTP locais - nunca versionar
# Use .env.example como template
.env
